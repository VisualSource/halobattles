    "weaponType": "plasma",
    "shield": 0,
    "armor": 8,
    "hp": 22,
    "damage": "3d8",
    // Artillery: shells from far behind the line, but can't fire up close.
    "range": 12,
    "minRange": 4,
    "fireInterval": 4,
    "speed": 1.5,
    "sight": 9,
    "tiers": {
