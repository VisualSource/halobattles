# Only server/ and mods/ (and deploy/pterodactyl/) go into the image; the
# rest is kept out so builds are reproducible and fast.
**/node_modules
client/
server/vendor/
server/build/
.git/
.claude/
docs/
# Local-only Mods (git-ignored, e.g. music someone else owns) stay out of images.
mods/voidreckon/
