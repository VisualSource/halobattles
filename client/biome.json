{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!src/gen",
      "!src/routeTree.gen.ts",
      "!pnpm-lock.yaml",
      "!dist"
    ]
  },
  "linter": {
    "domains": {
      "tailwind": "recommended",
      "react": "recommended",
      "tanstackQuery": "recommended"
    },
    "rules": {
      "nursery": {
        "useTailwindShorthandClasses": "error",
        "useTailwindSortedClasses": "error",
        "noTailwindRawColors": "error",
        "useReactCompiler": {
          "level": "error"
        }
      }
    }
  },
  "formatter": {
    "indentStyle": "space"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}