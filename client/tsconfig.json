{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    // Its package.json "exports" hides its typings.
    "paths": {
      "@heroiclabs/nakama-js-protobuf": [
        "./node_modules/@heroiclabs/nakama-js-protobuf/dist/nakama-js-protobuf/index.d.ts"
      ]
    }
  },
  "include": ["src", "vite.config.ts"]
}
