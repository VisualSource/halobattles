{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Weapon Type",
  "description": "A kind of damage, with a multiplier for each layer it hits.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "shield", "armor", "hp"],
  "properties": {
    "$schema": { "type": "string" },
    "replace": { "description": "Replace an existing definition with this id.", "type": "boolean" },
    "id": { "$ref": "defs.schema.json#/definitions/id" },
    "name": { "$ref": "defs.schema.json#/definitions/name" },
    "shield": { "type": "number", "minimum": 0 },
    "armor": { "type": "number", "minimum": 0 },
    "hp": { "type": "number", "minimum": 0 }
  }
}
