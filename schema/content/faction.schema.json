{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Faction",
  "description": "A playable side with its own units and buildings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "startingKit"],
  "properties": {
    "$schema": { "type": "string" },
    "replace": { "description": "Replace an existing definition with this id.", "type": "boolean" },
    "id": { "$ref": "defs.schema.json#/definitions/id" },
    "name": { "$ref": "defs.schema.json#/definitions/name" },
    "icon": { "$ref": "defs.schema.json#/definitions/asset" },
    "startingKit": {
      "title": "Starting Kit",
      "description": "Placed on the Faction's Capital when a Match starts. Starting resources are a lobby setting, not part of the kit.",
      "type": "object",
      "additionalProperties": false,
      "required": ["buildings", "stacks"],
      "properties": {
        "buildings": { "type": "array", "items": { "$ref": "defs.schema.json#/definitions/id" } },
        "stacks": { "$ref": "defs.schema.json#/definitions/stacks" }
      }
    }
  }
}
