// Match messages between the server and the browser (ADR 0002). Each opcode
// carries exactly one root table, with no union envelope. Content is referred
// to by its string id only.
namespace wire;

// 1–99 are client commands, 100 and up are server messages.
enum Op : int {
  None = 0,

  SetFaction = 1,
  SetReady = 2,
  SetMap = 3,
  SetStartingResources = 4,
  StartMatch = 5,
  QueueBuilding = 6,
  CancelQueueItem = 7,
  SellBuilding = 8,
  QueueUnit = 9,
  MoveUnits = 10,
  SetRallyStack = 11,
  OrderArmy = 12,
  ReorderArmy = 13,
  Surrender = 14,
  BattleRetreat = 15,
  BattleCancelRetreat = 16,
  BattleBuildTurret = 17,
  Exchange = 18,
  StartProject = 19,
  CancelProject = 20,
  AddBot = 21,
  RemoveBot = 22,
  Spectate = 23,
  TakeSeat = 24,
  SetTeams = 25,
  SetTeam = 26,
  SetRallyPoint = 27,
  SetBattleControl = 28,
  SetBattleCommand = 29,
  BattleOrder = 30,
  BattleLand = 31,
  RequestDefenceLayout = 32,
  SetDefenceLayout = 33,

  LobbyState = 100,
  CommandRejected = 101,
  ViewFull = 102,
  ViewDelta = 103,
  PaydayPaid = 104,
  PlanetCaptured = 105,
  BattleStarted = 106,
  BattleTick = 107,
  BattleEnded = 108,
  PlayerEliminated = 109,
  MatchEnded = 110,
  RaidTurnedBack = 111,
  DefenceLayout = 112,
}

enum Phase : byte { Lobby, Play, Results }

table Amount {
  resource: string (key);
  amount: int;             // signed: a player's Resources can go into debt
}

// Commands. Every one carries a client-assigned seq.

table SetFaction {
  seq: uint32;
  faction: string;
}

table SetReady {
  seq: uint32;
  ready: bool;
}

table AddBot {           // Host only: a Bot takes an empty Seat
  seq: uint32;
  faction: string;
  difficulty: string;      // a botDifficulties id
}

table RemoveBot {        // Host only
  seq: uint32;
  user: string;            // the Bot's Seat user
}

table Spectate {         // lobby only: give up your Seat to watch; a Host stays Host
  seq: uint32;
}

table TakeSeat {         // lobby only: a Spectator takes a free Seat
  seq: uint32;
}

table SetTeams {         // Host only: turn Teams on (Seats split between Teams 1 and 2) or off
  seq: uint32;
  on: bool;
}

table SetTeam {          // with Teams on: your own Team, or (Host only) a Bot's
  seq: uint32;
  user: string;            // the Seat's user
  team: ubyte;             // 1 to 4
}

table SetMap {           // Host only
  seq: uint32;
  map: string;
}

table SetStartingResources {  // Host only
  seq: uint32;
  amounts: [Amount];
}

table StartMatch {       // Host only
  seq: uint32;
}

table QueueBuilding {     // owner only
  seq: uint32;
  planet: string;
  slot: ubyte;             // an empty Building Slot
  building: string;
}

table CancelQueueItem {   // owner only
  seq: uint32;
  item_id: uint32;
}

table SellBuilding {      // owner only
  seq: uint32;
  planet: string;
  slot: ubyte;
}

table QueueUnit {         // owner only; expands into count queue items
  seq: uint32;
  planet: string;
  slot: ubyte;             // the production building's Building Slot
  unit: string;
  count: uint16;
}

table MoveUnits {         // owner only; from_stack = to_stack moves within it
  seq: uint32;
  planet: string;
  from_stack: ubyte;
  to_stack: ubyte;
  unit: string;
  count: uint32;
  to_cell: short = -1;    // the target cell; -1 tops up, then free cells
  from_cell: ubyte;        // the Unit Slot moved from; unit must match it
}

table SetRallyStack {     // owner only
  seq: uint32;
  planet: string;
  stack: ubyte;
}

table SetRallyPoint {     // owner only
  seq: uint32;
  planet: string;
  to: string;              // another of your Planets; "" keeps trained units home
}

table ArmyUnits {
  stack: ubyte;
  unit: string;
  count: uint32;
}

table OrderArmy {         // owner only
  seq: uint32;
  from_planet: string;
  units: [ArmyUnits];      // from any of its Stacks
  to_planet: string;
  to_stack: ubyte;
  raid: bool;              // a Raid: every unit can raid, within the Ruleset's raidCap
}

table ReorderArmy {       // owner only; finishes its current Lane hop first
  seq: uint32;
  army: uint32;
  to_planet: string;
  to_stack: ubyte;
  raid: bool;              // a Raid stays one only if this is set; else it's an Attack
}

table Surrender {         // any Seat, in play: a Forfeit
  seq: uint32;
}

// A side of the Battle on planet starts its Retreat countdown. A defender
// needs another Planet to Retreat to.
table BattleRetreat {
  seq: uint32;
  planet: string;
}

table BattleCancelRetreat { // only while the countdown runs
  seq: uint32;
  planet: string;
}

// A side builds a pad turret, building, on a build pad it holds in the Battle
// on planet, paying its cost now.
table BattleBuildTurret {
  seq: uint32;
  planet: string;
  pad: ubyte;              // the pad's index in BattleView.pads
  building: string;
}

// The player's default for their Battles: command them, or Auto. Sent on
// joining a Match and on each change; a Battle takes it when it starts.
table SetBattleControl {
  seq: uint32;
  command: bool;
}

// Whether you command your side of the Battle on planet, over your default:
// only in its setup, before the fighting starts.
table SetBattleCommand {
  seq: uint32;
  planet: string;
  command: bool;
}

enum BattleOrderKind : ubyte { Move = 0, Attack = 1, AttackMove = 2, Hold = 3 }

struct Cell {
  x: ushort;
  y: ushort;
}

// Asks for your Planet's defence layout; it comes back as a DefenceLayout.
table RequestDefenceLayout {
  seq: uint32;
  planet: string;
}

// A Stack's start in a defence layout.
table LayoutStart {
  stack: ubyte;
  x: ushort;
  y: ushort;
}

// Sets your Planet's defence layout, whole; empty lists reset it. It's
// answered with a DefenceLayout.
table SetDefenceLayout {
  seq: uint32;
  planet: string;
  sites: [byte];           // per Building Slot: the base site it stands on; -1 its default
  starts: [LayoutStart];
}

// Sends one of your side's Dropships in orbit over the Battle on planet to a
// Landing Zone your side holds; you must command the Battle.
table BattleLand {
  seq: uint32;
  planet: string;
  drop: ubyte;             // its index in BattleView.drops
  point: ubyte;            // the Landing Zone's index in BattleView.points
}

// Orders squads of your side in a Battle you command. A group sent to a
// cell keeps its shape round it.
table BattleOrder {
  seq: uint32;
  planet: string;
  kind: BattleOrderKind;
  squads: [ushort];
  x: ushort;               // Move and AttackMove
  y: ushort;
  target: ushort;          // Attack: the enemy squad
}

table Exchange {          // any time in play, even in debt
  seq: uint32;
  give: string;            // a Resource
  get: string;             // a Resource
  amount: int;             // how much to give: a whole multiple of its rate's giveAmount
}

table StartProject {      // a Tech from the hand or a saved Project, in a Lab with a free Tech Slot
  seq: uint32;
  tech: string;
  planet: string;
  slot: ubyte;             // the Lab's Building Slot
}

table CancelProject {     // saved with its progress
  seq: uint32;
  tech: string;
}

// Server messages.

table Seat {
  user: string;
  display_name: string;
  faction: string;
  ready: bool;
  last_seq: uint32;      // the last command seq processed from this Seat
  bot: string;           // a Bot's difficulty id; "" for a player
  team: ubyte;           // 1 to 4 with Teams on; 0 with them off
}

// Someone in the lobby who'll watch rather than play.
table Spectator {
  user: string;
  display_name: string;
  last_seq: uint32;      // the last command seq processed from them
}

// Sent whole to everyone on join and on every lobby change.
table LobbyState {
  phase: Phase;
  host: string;            // the Host's user id
  map: string;
  starting_resources: [Amount];
  seats: [Seat];           // in Seat order: longest held first
  winner: byte = -1;       // in results: a Team (Team 1 is 0; with Teams off, a Seat index); -1 is none
  end_reason: string;      // in results: "hold", "last-standing", ...
  spectators: [Spectator]; // longest here first
  teams: bool;             // each Seat picks a Team; off is a free-for-all
}

// Sent to the sender of a command the server refused.
table CommandRejected {
  seq: uint32;
  reason: string;
  match_time: long;        // 0 in the lobby
}

// The View: one player's picture of the Match, the only state they get.

table UnitSlot {
  unit: string;
  count: uint32;
  cell: ubyte;             // its place in the Stack's grid; one slot per cell
}

table Stack {
  slots: [UnitSlot];       // in no order: cell places each
}

// One item in a queue: a Planet's construction queue, or a production
// building's unit queue. Only the first runs: it has ends_at while running,
// or paused while it can't (debt or Locked). Later items wait with their full
// remaining time. A finished unit with no room in any Stack stays first, with
// ends_at in the past, and blocks its queue.
table QueueItem {
  id: uint32;
  slot: ubyte;             // the Building Slot it fills, or trains at
  building: string;        // a construction item
  unit: string;            // a unit item
  started: bool;           // cancelling a started item refunds less
  paused: bool;
  ends_at: long;           // Match Time; 0 unless running
  remaining: long;         // ms left, when not running
}

// A Planet in vision. Planets outside vision are left out; the client has
// their static data from content.
table PlanetView {
  id: string (key);
  owner: byte = -1;        // a Seat index; -1 is neutral
  capital: bool;
  locked: bool;
  buildings: [string];     // one per Building Slot; "" is empty
  stacks: [Stack];         // the Planet's three Stacks
  queue: [QueueItem];      // construction, in order; only on your own Planets
  unit_queue: [QueueItem]; // every unit queue, by slot then order; own only
  rally_stack: ubyte;      // where trained units go; own Planets only
  richness: [Richness];    // per Resource; a Resource left out is none
  labs: [Lab];             // the Techs each Lab holds; public, like its buildings
  rally_point: string;     // where trained units leave for; own Planets only
}

table Lab {
  slot: ubyte (key);       // its Building Slot
  techs: [string];
}

table Richness {
  resource: string (key);
  level: string;           // none, poor, normal or rich
}

// An Army in vision: on its current Lane hop, or waiting in orbit at `to`.
// Other players' Armies never show where they're headed.
table ArmyView {
  id: uint32 (key);
  owner: byte;
  units: [UnitSlot];
  from: string;
  to: string;
  departed: long;          // Match Time
  arrives: long;           // Match Time
  waiting: bool;
  destination: string;     // own only
  to_stack: ubyte;         // own only
  path: [string];          // own only: the Planets after to, in order
  raid: bool;              // own only: others don't see a Raid at all
}

// A Battle's grid: one Terrain index and one height level per cell, row by
// row. Sent only in ViewFull and BattleStarted; it never changes.
table Battlefield {
  width: ushort;
  height: ushort;
  terrains: [string];      // Terrain ids; a cell holds an index into this
  terrain: [ubyte];
  heights: [ubyte];
}

// A Unit Slot or building in a Battle, as your side sees it.
table BattleSquad {
  id: ushort (key);        // unique in the Battle
  side: ubyte;             // 0 attacker, 1 defender
  unit: string;            // a unit or building id
  building: bool;
  x: ushort;
  y: ushort;
  count: uint32;           // members left
  start: uint32;           // members at the start
  shield: float;           // the front member's layers: it takes the hits
  armor: float;
  hp: float;
  command_post: bool;      // the defender's Command Post: destroying it wins the Battle
  moving: bool;            // your own squads': on its way to goal
  goal_x: ushort;
  goal_y: ushort;
  target: ushort;          // your own squads': the enemy it was told to attack, or 0
  dropship: bool;          // a Dropship in flight: only anti-air can fire on it, and both sides see it
}

enum DropState : ubyte { Orbit = 0, Flying = 1, Done = 2 }

// One of your side's Dropships over a Battle: waiting in orbit, on its way
// to a Landing Zone, or done, having landed its troops (once a Battle).
table BattleDrop {
  unit: string;            // the Dropship's unit id
  units: ushort;           // the troops it carries
  state: DropState;
  point: byte = -1;        // the Landing Zone it's going to, or went to
  ai_at: uint32;           // in orbit: the tick the AI sends it, if nobody has
}

table ControlPoint {      // shown to players as a Landing Zone
  x: ushort;
  y: ushort;
  owner: ubyte;            // 0 attacker, 1 defender, 255 nobody
  taker: ubyte;            // the side taking it, while progress > 0; 255 nobody
  progress: ushort;        // sim ticks the taker has held it alone
}

// A build pad: public, like the Control Points.
table BuildPad {
  x: ushort;
  y: ushort;
  owner: byte = -1;        // 0 attacker, 1 defender; -1 is nobody
  taker: byte = -1;
  progress: ushort;        // sim ticks the taker has held it alone
  turret: ushort;          // the turret squad on it, or 0
  building: string;        // a turret under construction, or ""
  ready_at: uint32;        // the tick it's built
  cools_at: uint32;        // its turret destroyed: the tick it can be built on again
}

// A Battle you're a side of, as your side sees it: your own squads and the
// enemies in your Sight. Anyone else with vision sees only the Locked flag.
table BattleView {
  id: uint32 (key);
  planet: string;
  attacker: byte;
  defender: byte = -1;     // -1 is neutral
  started: long;           // Match Time of tick 0
  tick: uint32;            // sim ticks run, 5 a second
  edge: ubyte;             // the attacker's edge: 0 top, 1 right, 2 bottom, 3 left
  field: Battlefield;      // in ViewFull only; deltas leave it out
  squads: [BattleSquad];
  points: [ControlPoint];
  pads: [BuildPad];
  hold: uint32 (deprecated);      // the hold timer, gone with the Command Post (#98)
  hold_paused: bool (deprecated);
  retreat_at: uint32;      // the tick your side's Retreat countdown ends; 0 is none
  attacker_retreating: bool; // public: you see a side turn and run
  defender_retreating: bool;
  raid: bool;              // a Raid: the attacker has raidTime to destroy the buildings
  buildings_left: ubyte;    // public: the Planet's buildings standing, a Raid's score
  buildings: ubyte;         // and at the start
  commanded: bool;         // your side is yours to command: the AI doesn't run it
  drops: [BattleDrop];     // your side's Dropships
}

// One squad's fire in one sim tick: every living member's shot at one
// target, added up.
table Volley {
  actor: ushort;           // 0: a shooter your side can't see
  target: ushort;
  shots: ushort;
  hits: ushort;
  kills: ushort;
  shield_dmg: float;
  armor_dmg: float;
  hp_dmg: float;
}

// The public part of every player.
table PlayerView {
  seat: ubyte;
  user: string;
  display_name: string;
  faction: string;
  planet_count: uint16;
  eliminated: bool;
  connected: bool;
  grace_ends: long;        // Match Time a disconnected player forfeits at
  bot: string;             // a Bot's difficulty id; "" for a player
  stats: PlayerStats;      // only in a Spectator's View
  team: ubyte;             // Team 1 is 0; with Teams off, the Seat index
}

// What a Spectator sees of a player's economy.
table PlayerStats {
  resources: [Amount];
  income: [Amount];        // what the next Payday would change
  command_points_used: uint32;
  command_points_cap: uint32;
}

// The running win-hold countdown, public to everyone.
table WinHold {
  seat: byte = -1;         // the Team holding (Team 1 is 0; with Teams off, a Seat); -1 is none
  ends: long;              // Match Time
}

// The viewer's own economy. Never sent for anyone else.
table Economy {
  resources: [Amount];
  command_points_used: uint32;
  command_points_cap: uint32;
  payday_start: long;      // Match Time of the last Payday (or Start)
  payday_end: long;        // Match Time of the next Payday
  caps: [Amount];          // Stockpile caps, storage included
  projected: [Amount];     // what the next Payday would change if it came now, Upkeep and refining included; before caps
}

// A running Project: done Research as of since, growing at rate per second
// (0 while paused) until it reaches cost. It changes only when its rate does.
table Project {
  tech: string;
  planet: string;
  slot: ubyte;             // its Lab's Building Slot
  cost: uint32;
  done: double;
  since: long;             // Match Time
  rate: double;
}

// A guaranteed card, offered beside the hand until picked: a stopped
// Project, or a lost Tech (lost, done 0, at its recovery cost right now).
table SavedProject {
  tech: string;
  cost: uint32;
  done: double;
  lost: bool;
}

// The viewer's own research. Never sent for anyone else.
table Research {
  fields: [ResearchField]; // every Research field, sorted by id
  projects: [Project];     // at most one per field
  saved: [SavedProject];
}

table ResearchField {
  field: string (key);
  rate: uint32;            // Research per second
  hand: [string];          // Techs offered while the field has no Project
}

// Sent on entering play and on every rejoin. Content is referred to by id;
// a client whose cached content doesn't match content_hash refetches it.
table ViewFull {
  match_time: long;        // ms since Start
  content_hash: string;
  ruleset: string;
  map: string;
  you: ubyte;              // the viewer's Seat
  players: [PlayerView];   // by Seat
  planets: [PlanetView];
  economy: Economy;
  armies: [ArmyView];
  battles: [BattleView];
  win_hold: WinHold;
  research: Research;
  spectating: bool;        // a Spectator's View: no fog, no economy or research, you means nothing
}

// Sent on a tick when the viewer's View changed since the last one sent.
// Entities are whole upserts; a Planet leaving vision is in removed_planets.
table ViewDelta {
  match_time: long;
  players: [PlayerView];   // changed players only
  planets: [PlanetView];
  removed_planets: [string];
  economy: Economy;        // absent when unchanged
  armies: [ArmyView];
  removed_armies: [uint32];
  battles: [BattleView];
  removed_battles: [uint32];
  win_hold: WinHold;       // absent when unchanged
  research: Research;      // absent when unchanged
}

// Sent to a Raid's owner: it found no buildings at planet and is heading home.
table RaidTurnedBack {
  match_time: long;
  planet: string;
}

// Sent to everyone who can see the Planet, and its previous owner.
table PlanetCaptured {
  match_time: long;
  planet: string;
  from: byte = -1;         // a Seat index; -1 is neutral
  to: byte;
}

// Sent to the two sides when a Battle starts. Its state comes in the View.
table BattleStarted {
  match_time: long;
  battle: uint32;
  planet: string;
  attacker: byte;
  defender: byte = -1;
  started: long;
  field: Battlefield;
  raid: bool;
}

// Sent to each side on a sim tick with fire it may know about.
table BattleTick {
  match_time: long;
  battle: uint32;
  planet: string;
  tick: uint32;
  volleys: [Volley];
}

// Sent to everyone who can see the Planet, and both sides.
table BattleEnded {
  match_time: long;
  battle: uint32;
  planet: string;
  winner: byte = -1;       // a Seat; -1 is neutral
}

// Sent to everyone.
table PlayerEliminated {
  match_time: long;
  seat: ubyte;
}

// Sent to everyone; the Match moves to results.
table MatchEnded {
  match_time: long;
  winner: byte = -1;       // a Team (Team 1 is 0; with Teams off, a Seat index); -1 is none
  reason: string;
}

// Sent to one player at each Payday: what each Resource changed by.
table PaydayPaid {
  match_time: long;
  net: [Amount];
}

// Your Planet's defence layout: the Battlefield you'd defend it on, and
// where your buildings and Stacks start on it.
table DefenceLayout {
  planet: string;
  field: Battlefield;
  command_post: Cell;
  sites: [Cell];           // the base's building sites
  points: [Cell];          // Landing Zones
  landings: [Cell];        // the ones an attacker may land at
  pads: [Cell];
  reach: float;            // a Stack starts this near the Command Post or a building
  building_sites: [byte];  // per Building Slot: the site it stands on; -1 by the Command Post, or empty
  stack_starts: [Cell];    // where each Stack deploys
  set_sites: [byte];       // the layout as set: per Building Slot, -1 is its default
  set_starts: [LayoutStart];
}
