{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ruleset",
  "description": "Game-wide tuning values. There is exactly one, `base:rules`, which later Mods Patch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "paydaySeconds",
    "cancelRefundPercent",
    "sellRefundPercent",
    "unitSlotsPerStack",
    "tiers",
    "laneTypes",
    "initiativeDie",
    "roundSeconds",
    "roundCap",
    "startingResources",
    "gracePeriodSeconds",
    "resultsSeconds"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "replace": { "description": "Replace an existing definition with this id.", "type": "boolean" },
    "id": { "$ref": "defs.schema.json#/definitions/id" },
    "name": { "$ref": "defs.schema.json#/definitions/name" },
    "paydaySeconds": { "description": "Time between Paydays.", "type": "integer", "minimum": 1 },
    "cancelRefundPercent": {
      "description": "Refund for cancelling a queue item after it started.",
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "sellRefundPercent": { "description": "Refund for selling a building.", "type": "integer", "minimum": 0, "maximum": 100 },
    "unitSlotsPerStack": { "type": "integer", "minimum": 1 },
    "tiers": {
      "description": "Damage multiplier per tier name. A Unit Class missing from a combat block's tiers counts as `average`.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9_-]+$" },
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "laneTypes": {
      "description": "Travel-time multiplier per Lane type.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9_-]+$" },
      "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
    },
    "initiativeDie": { "description": "Sides on the Initiative die.", "type": "integer", "minimum": 1 },
    "roundSeconds": { "description": "Duration of one Battle Round.", "type": "integer", "minimum": 1 },
    "roundCap": { "description": "Most Rounds a Battle can run.", "type": "integer", "minimum": 1 },
    "startingResources": {
      "description": "Defaults the lobby fills in.",
      "$ref": "defs.schema.json#/definitions/resourceMap"
    },
    "gracePeriodSeconds": { "description": "How long a disconnected player keeps their Seat.", "type": "integer", "minimum": 0 },
    "resultsSeconds": { "description": "How long a Match stays in results.", "type": "integer", "minimum": 0 }
  }
}
